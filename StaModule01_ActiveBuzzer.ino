/*
  ========================================================================
  PROJECT: Stadxn (Offline-First Attendance System)
  MODULE 1: Active Buzzer Test
  ========================================================================
  
  [ របៀបតខ្សែ / WIRING DIAGRAM ]
  - Buzzer Pin (+) [ជើងមានសញ្ញា + ឬជើងវែង] -> ESP32 GPIO12 (សរសេរលើ Board: D12)
  - Buzzer Pin (-) [ជើងគ្មានសញ្ញា + ឬជើងខ្លី] -> ESP32 GND (ជើងដី)
  
  [ ចំណាំ / NOTE ]
  - Active Buzzer មានសៀគ្វីបង្កើតសំឡេងស្រាប់ក្នុងខ្លួន។
  - ពេលបញ្ជូនភ្លើង HIGH (3.3V) ពី GPIO12 វានឹងបន្លឺសំឡេង។
  - ពេលបញ្ជូនភ្លើង LOW (0V) វានឹងបិទសំឡេង។
  ========================================================================
*/

// កំណត់ជើង GPIO 12 សម្រាប់ភ្ជាប់ទៅជើង (+) របស់ Active Buzzer
const int BUZZER_PIN = 12;

void setup() {
  // កំណត់ជើង GPIO 12 ឱ្យធ្វើការជា Output (បញ្ចេញសញ្ញាភ្លើង)
  pinMode(BUZZER_PIN, OUTPUT);
}

void loop() {
  // --- ដំណាក់កាលទី ១: សំឡេង ប៊ីប លើកទី១ ---
  digitalWrite(BUZZER_PIN, HIGH); // បញ្ជូនភ្លើង 3.3V ទៅ Buzzer -> បើកសំឡេង
  delay(100);                     // រង់ចាំរយៈពេល ០.១ វិនាទី (100 milliseconds)
  
  digitalWrite(BUZZER_PIN, LOW);  // បិទភ្លើង 0V -> បិទសំឡេង
  delay(100);                     // ផ្អាកចន្លោះសំឡេង ០.១ វិនាទី

  // --- ដំណាក់កាលទី ២: សំឡេង ប៊ីប លើកទី២ ---
  digitalWrite(BUZZER_PIN, HIGH); // បញ្ជូនភ្លើង 3.3V ទៅ Buzzer -> បើកសំឡេង
  delay(100);                     // រង់ចាំរយៈពេល ០.១ វិនាទី
  
  digitalWrite(BUZZER_PIN, LOW);  // បិទភ្លើង 0V -> បិទសំឡេង

  // --- ដំណាក់កាលទី ៣: សម្រាក ---
  delay(2000);                    // ផ្អាកស្ងាត់រយៈពេល ២ វិនាទី (2000 ms) រួចធ្វើសារឡើងវិញ
}
